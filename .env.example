# ==========================================
# SERVER & BOT CONFIGURATION
# ==========================================
PORT=8100
HOST=0.0.0.0
OWNER_NUMBER=923238522260
DEFAULT_PROVIDER=nvidia
AUTO_REPLY_ENABLED=true
DASHBOARD_SECRET=your_super_secret_dashboard_key_here

# ==========================================
# GROQ API KEYS & MODELS
# ==========================================
GROQ_API_KEYS=gsk_key1,gsk_key2

# ------------------------------------------
# GROQ - 1. SELECTOR / ROUTER
# ------------------------------------------
GROQ_ROUTER_MODEL=allam-2-7b
GROQ_ROUTER_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.6-27b,openai/gpt-oss-120b

# ------------------------------------------
# GROQ - 2. CHAT / SIMPLE
# ------------------------------------------
GROQ_MODEL_SIMPLE=allam-2-7b
GROQ_SIMPLE_FALLBACK_MODELS=qwen/qwen3.6-27b,openai/gpt-oss-20b,openai/gpt-oss-120b

# ------------------------------------------
# GROQ - 3. REASONING
# ------------------------------------------
GROQ_MODEL_REASONING=openai/gpt-oss-120b
GROQ_REASONING_FALLBACK_MODELS=openai/gpt-oss-20b

# ------------------------------------------
# GROQ - 4. PDF GENERATOR
# ------------------------------------------
GROQ_MODEL_PDF=openai/gpt-oss-120b
GROQ_PDF_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.6-27b

# ------------------------------------------
# GROQ - 5. PPT / PPTX GENERATOR
# ------------------------------------------
GROQ_MODEL_PPTX=openai/gpt-oss-120b
GROQ_PPTX_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.6-27b

# ------------------------------------------
# GROQ - 6. IMAGE / VISION
# ------------------------------------------
GROQ_MODEL_MULTIMODAL=qwen/qwen3.6-27b
GROQ_MULTIMODAL_FALLBACK_MODELS=

# ------------------------------------------
# GROQ - 7. AUDIO / SPEECH-TO-TEXT
# ------------------------------------------
GROQ_MODEL_AUDIO=whisper-large-v3-turbo
GROQ_AUDIO_FALLBACK_MODELS=whisper-large-v3

# ==========================================
# NVIDIA NIM API KEYS
# ==========================================
NVIDIA_API_KEYS=nvapi-key1,nvapi-key2

# ------------------------------------------
# NVIDIA - 1. SELECTOR / ROUTER
# ------------------------------------------
NVIDIA_ROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_ROUTER_FALLBACK_MODELS=openai/gpt-oss-20b,minimaxai/minimax-m3,meta/llama-3.1-8b-instruct

# ------------------------------------------
# NVIDIA - 2. CHAT / SIMPLE
# ------------------------------------------
NVIDIA_MODEL_SIMPLE=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_SIMPLE_FALLBACK_MODELS=openai/gpt-oss-120b,minimaxai/minimax-m3,nvidia/llama-3.1-nemotron-nano-vl-8b-v1,meta/llama-3.1-8b-instruct

# ------------------------------------------
# NVIDIA - 3. REASONING
# ------------------------------------------
NVIDIA_MODEL_REASONING=openai/gpt-oss-120b
NVIDIA_REASONING_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b,minimaxai/minimax-m3,nvidia/nemotron-3-ultra-550b-a55b,z-ai/glm-5.2

# ------------------------------------------
# NVIDIA - 4. PDF GENERATOR
# ------------------------------------------
NVIDIA_MODEL_PDF=openai/gpt-oss-120b
NVIDIA_PDF_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b,minimaxai/minimax-m3,nvidia/nemotron-3-ultra-550b-a55b,z-ai/glm-5.2

# ------------------------------------------
# NVIDIA - 5. PPT / PPTX GENERATOR
# ------------------------------------------
NVIDIA_MODEL_PPTX=nvidia/nemotron-3-super-120b-a12b
NVIDIA_PPTX_FALLBACK_MODELS=openai/gpt-oss-120b,nvidia/nemotron-3-ultra-550b-a55b,minimaxai/minimax-m3,z-ai/glm-5.2

# ------------------------------------------
# NVIDIA - 6. MULTIMODAL / VISION
# ------------------------------------------
NVIDIA_MODEL_MULTIMODAL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_MULTIMODAL_FALLBACK_MODELS=minimaxai/minimax-m3,nvidia/nemotron-nano-12b-v2-vl,nvidia/llama-3.1-nemotron-nano-vl-8b-v1,nvidia/nemotron-3-nano-30b-a3b

# ------------------------------------------
# NVIDIA - 7. AUDIO / SPEECH-TO-TEXT
# ------------------------------------------
NVIDIA_MODEL_AUDIO=nvidia/nemotron-asr-streaming
NVIDIA_AUDIO_FALLBACK_MODELS=nvidia/nemotron-voicechat

# ==========================================
# ANTI-BAN & RATE LIMITING
# ==========================================
ANTI_BAN_MIN_DELAY_MS=5000
ANTI_BAN_MAX_DELAY_MS=8000
RATE_LIMIT_MAX_PER_MINUTE=3

# ==========================================
# STORAGE & PATHS
# ==========================================
SESSION_DIR=./auth_info_baileys
DB_FILE_PATH=./db.json
SYSTEM_PROMPT_PATH=./system.md
